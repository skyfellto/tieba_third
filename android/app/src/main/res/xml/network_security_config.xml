<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">tieba.baidu.com</domain>
        <domain includeSubdomains="true">headimg.tieba.baidu.com</domain>
        <domain includeSubdomains="true">tiebac.baidu.com</domain>
        <domain includeSubdomains="true">tb.himg.baidu.com</domain>
    </domain-config>
</network-security-config>